#!/usr/bin/env python3
import sys, os, re, colorsys, subprocess
from PIL import Image

HOME = os.path.expanduser("~")
CSS = HOME + "/.config/waybar/style.css"
OVERRIDES = HOME + "/.config/wall-accents.conf"   # linhas: nome-do-arquivo.jpg #rrggbb

def override(path):
    try:
        name = os.path.basename(path)
        for line in open(OVERRIDES):
            parts = line.split()
            if len(parts) >= 2 and parts[0] == name and re.fullmatch(r"#[0-9a-fA-F]{6}", parts[1]):
                return parts[1].lower()
    except OSError:
        pass
    return None

def to_accent(h, s):
    s_out = max(0.35, min(0.80, 0.25 + 0.6 * s))
    r, g, b = colorsys.hsv_to_rgb(h, s_out, 1.0)
    return "#%02x%02x%02x" % (round(r*255), round(g*255), round(b*255))

def ranked(path):
    im = Image.open(path).convert("RGB")
    im.thumbnail((128, 128))
    total = im.width * im.height
    q = im.quantize(colors=12, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette()
    cols = []
    for count, idx in q.getcolors():
        r, g, b = pal[idx*3:idx*3+3]
        h, s, v = colorsys.rgb_to_hsv(r/255, g/255, b/255)
        share = count / total
        sc = 0.0 if v < 0.18 else (share ** 0.5) * (s ** 1.2) * (1.0 if 0.30 <= v <= 0.95 else 0.6)
        cols.append((sc, h, s))
    cols.sort(reverse=True)
    return cols

def pick(path):
    cols = ranked(path)
    best = cols[0]
    if best[2] < 0.10:
        return "#c8c8d4"
    return to_accent(best[1], best[2])

def hex_hue(c):
    r, g, b = (int(c[i:i+2], 16) / 255 for i in (1, 3, 5))
    h, sat, _ = colorsys.rgb_to_hsv(r, g, b)
    return h, sat

def palette(path, n=5):
    first = pick(path)
    out = [first]
    fh, fs = hex_hue(first)
    hues = [fh]
    near = lambda h: any(min(abs(h - x), 1 - abs(h - x)) < 0.07 for x in hues)
    for sc, h, s in ranked(path):
        if len(out) >= n:
            break
        if sc <= 0 or s < 0.10 or near(h):
            continue
        hues.append(h)
        out.append(to_accent(h, s))
    # poucas cores na imagem: completa com tons vizinhos e o oposto
    base_s = max(0.5, fs) if fs < 0.3 else fs
    for dh in (0.083, -0.083, 0.5, 0.167):
        if len(out) >= 4:
            break
        h = (fh + dh) % 1.0
        if near(h):
            continue
        hues.append(h)
        out.append(to_accent(h, base_s))
    return out

def main():
    args = sys.argv[1:]
    mode = None
    if args and args[0] in ("--test", "--palette"):
        mode, args = args[0], args[1:]
    if not args:
        sys.exit("uso: wall-accent [--test|--palette] imagem")
    path = args[0]
    if mode == "--palette":
        print("\n".join(palette(path)))
        return
    cor = override(path)
    origem = "manual" if cor else "automatica"
    if not cor:
        cor = pick(path)
    if mode == "--test":
        print(cor, origem)
        return
    try:
        atual = re.search(r"@define-color accent\s+(#[0-9a-fA-F]{6})", open(CSS).read()).group(1).lower()
    except Exception:
        atual = ""
    if atual == cor:
        print("cor ja era", cor)
        return
    print("cor do wallpaper:", cor, "(" + origem + ")")
    subprocess.run([HOME + "/.local/bin/waybar-color", cor])

main()
